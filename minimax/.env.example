# ============================================================
# SDD 上下文管理模块配置样例
#   cp .env.example .env 后按需修改；.env 不要提交真实凭据
#   本模块不是自动读 .env 的框架，请用 scripts/with-env 或直接 export
# ============================================================

# ---- seekdb（工程资料库，MySQL 协议）----
# 换机器/换端口时只改这里；模块启动时会自动探测 2881/2882/2880/2883/3306
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
# 库名固定独立，避免和其他模块冲突
SDD_DB_NAME=sdd_minimax

# ---- 工程与产物路径（留空则用 minimax/ 下的默认位置）----
# SDD_HOME=
# SDD_PROJECT=./demo_project
# SDD_RECORDS_DIR=./records
# SDD_STATE_DIR=./.state
# SDD_SAMPLE_DIR=./sample
# 指定 Python 解释器（默认当前 python / python3）
# SDD_PYTHON=

# ---- MiniMax（OpenAI 兼容接口）----
# 不设置 MINIMAX_API_KEY 时，apply 自动进入“离线回放模式”：
#   使用 sample/offline_patch.diff 里同一份 patch，并在 records/minimax.jsonl 标注 mode=replay
# 注意：.env 请保存为 UTF-8 无 BOM（PowerShell 的 Set-Content -Encoding utf8 会加 BOM，
#       首行键名会带上 \ufeff，导致 bash source / docker-compose 读不到）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
# 主模型失败（如 402 余额不足）后依次尝试的备选模型
MINIMAX_MODEL_FALLBACKS=MiniMax-M3.1-Flash,MiniMax-M2.7
MINIMAX_TIMEOUT=180

# ---- PowerContext（任务状态复用）----
# 本机实测实例在 8001；官方默认 8000。模块会先探测 8001 再 8000
POWERCONTEXT_BASE_URL=http://127.0.0.1:8001
# 本地免鉴权时留空；启用鉴权后填 Server Token
POWERCONTEXT_SERVER_AUTH_TOKEN=
# 复用已有 Scope 时填 scp_ 开头的 ID；留空则按 title=sdd-context:minimax 查找/创建
POWERCONTEXT_SCOPE_ID=
# auto（默认）/ powercontext / file
SDD_STATE_BACKEND=auto
