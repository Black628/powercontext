2026-10-28T01:03:26+08:00  SELECT c.clause_id, c.title, c.body, c.path, c.line_start, c.line_end, c.digest, s.score FROM spec_clauses c JOIN ( SELECT clause_id, SUM(weight) AS score FROM spec_keywords WHERE keyword IN (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) GROUP BY clause_id ) s ON s.clause_id = c.clause_id ORDER BY s.score DESC, c.clause_id LIMIT %s  -- params: ["订单", "单满", "元免", "免运", "运费", "会员", "员折", "折扣", "扣后", "后金", "金额", "额不", "不足", "元时", "时应", "应按", "按折", "折后", "额判", "判断", "金卡", "卡会", "员始", "始终", "终免", 8]
2026-10-28T01:03:26+08:00  SELECT c.symbol_id, c.kind, c.qualname, c.path, c.line_start, c.line_end, c.signature, c.docstring, c.clause_refs, s.score FROM code_symbols c JOIN ( SELECT symbol_id, SUM(weight) AS score FROM symbol_keywords WHERE keyword IN (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s) GROUP BY symbol_id ) s ON s.symbol_id = c.symbol_id ORDER BY s.score DESC, c.symbol_id LIMIT %s  -- params: ["订单", "单满", "元免", "免运", "运费", "会员", "员折", "折扣", "扣后", "后金", "金额", "额不", "不足", "元时", "时应", "应按", "按折", "折后", "额判", "判断", "金卡", "卡会", "员始", "始终", "终免", 10]
