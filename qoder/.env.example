# ===== Recall Coach / 知新 配置示例（复制为 .env 后填写真实值）=====
# 所有变量都是可选的：全部留空时应用使用内置默认值（SQLite 镜像后端 + 嵌入式 PowerContext）。

# ---- 服务监听 ----
COACH_HOST=127.0.0.1
COACH_PORT=8848
# auto = 先尝试 seekdb，不可用时自动降级为 mirror；也可写 seekdb / mirror 强制指定
COACH_BACKEND=auto
# 应用数据目录（PowerContext 工作区、scope 记录、镜像库都在这里）
COACH_DATA_DIR=
COACH_LEARNER=小林

# ---- seekdb（资料库混合检索）----
# 嵌入式（推荐，Linux/macOS）：指向一个目录，pylibseekdb 会在其中拉起引擎；留空 = <data_dir>/seekdb
SEEKDB_PATH=
# 远程（已有 seekdb / OceanBase 服务时）：形如 127.0.0.1:2881；设置后优先于嵌入式
SEEKDB_URI=
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DB=recall_coach

# ---- PowerContext（学习者记忆）----
# embedded（默认，进程内启动服务端 + SQLite 持久化）或 external（连接已有服务）
COACH_PC_MODE=embedded
COACH_PC_URL=
COACH_PC_WORKSPACE=
COACH_PC_TOKEN=

# ---- embedding ----
# builtin-hash（默认，零依赖）或 OpenAI 兼容接口；填写 key+model 即切换为 openai
COACH_EMBEDDING_DIM=1024
COACH_EMBEDDING_BASE_URL=
COACH_EMBEDDING_API_KEY=
COACH_EMBEDDING_MODEL=

# ---- 可选 LLM（只在配置后启用"生成题解"按钮）----
COACH_LLM_BASE_URL=
COACH_LLM_API_KEY=
COACH_LLM_MODEL=
