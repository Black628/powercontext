# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交真实密钥。
# 所有变量都有代码内默认值，.env 可以只写需要覆盖的项。

# ---- seekdb（MySQL 协议）----
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=recall

# ---- embedding ----
# hash：确定性哈希词袋，离线可跑；sentence_transformers：需另装依赖并设置 EMBEDDING_MODEL
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=384
EMBEDDING_MODEL=

# ---- 切块 ----
CHUNK_SIZE=500

# ---- PowerContext 1.4.x HTTP 服务 ----
POWERCONTEXT_BASE_URL=http://127.0.0.1:8001
POWERCONTEXT_API_KEY=
POWERCONTEXT_TIMEOUT=3

# ---- 可选 LLM（留空则 /api/ask 退化为抽取式回答，仍带 [n] 引用）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

# ---- 提效统计 ----
# 手动翻 PDF 找同一答案 3 次的中位数（秒）；0 表示尚未实测，/api/stats 不估算节省时间
MANUAL_LOOKUP_SECONDS=0
RECALL_LOOKUP_SECONDS=10
