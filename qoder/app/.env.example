# ============================================================
# Recall 配置样例：复制为 .env 后填真实值；所有密钥均为占位值，禁止提交真实密钥
# ============================================================

# ---- seekdb（MySQL 协议 2881）----
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=<在此填写，勿提交真实密码>
SEEKDB_DATABASE=recall

# ---- embedding ----
# hash（默认，离线确定性哈希向量，无需密钥）| sentence_transformers
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=384
# sentence_transformers 时必填，例如 sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=

# ---- PowerContext 记忆服务 ----
POWERCONTEXT_BASE_URL=http://127.0.0.1:8001
POWERCONTEXT_API_KEY=<在此填写，勿提交真实密钥>
POWERCONTEXT_TIMEOUT=3

# ---- 问答用的 LLM 网关（可留空，留空则退化为抽取式回答）----
LLM_BASE_URL=
LLM_API_KEY=<在此填写，勿提交真实密钥>
LLM_MODEL=
LLM_TIMEOUT=30

# ---- 切块与提效估算 ----
CHUNK_SIZE=500
MANUAL_LOOKUP_SECONDS=1800
RECALL_LOOKUP_SECONDS=10
