      {
        "data": {
          "code": "import json\nimport re\n\n\ndef main(player_id: str, user_id: str, utterance: str) -> dict:\n    raw = (player_id or \"\").strip()\n    if not raw:\n        # 没报名号时退回 Dify 的会话身份，保证同一位体验者跨会话共用一本账。\n        user = (user_id or \"\").strip()\n        raw = \"dx-\" + user[:8] if user else \"guest\"\n    # 只保留字母数字、汉字与下划线/连字符，避免 scope 标识里出现奇怪字符\n    key = re.sub(r\"[^0-9A-Za-z_\\u4e00-\\u9fff-]\", \"-\", raw)[:48] or \"guest\"\n    said = (utterance or \"\").strip() or \"（客人沉默不语）\"\n    return {\n        \"player_key\": key,\n        \"query_json\": json.dumps(said),\n        \"reason_json\": json.dumps(\"玩家原话：\" + said, ensure_ascii=False),\n    }\n",
          "code_language": "python3",
          "desc": "规范化玩家ID（留空则用 Dify 会话用户兜底），并把这一回合的话转成可直接拼进 JSON 的安全字面量",
