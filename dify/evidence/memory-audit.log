        "entry_version_id": "mem_ver_9fe9fe470bb14b3381dc964dcdccfa3c"
      },
      "version": 1,
      "kind": "favor",
      "text": "客人拎来三坛桂花酿，把上次摔碗的账认了。（原话：上次的事是我不对，我赔你三坛酒。）",
      "state": "active",
      "source_refs": [],
      "artifact_refs": []
