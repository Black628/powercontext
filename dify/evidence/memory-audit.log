        },
        "entry_id": "mem_ent_c1b4f0d2e0ab4bd7bb76d2112769abea",
        "entry_version_id": "mem_ver_53dd3cdafa6542448c1a8620dc7fe54f"
      },
      "version": 1,
      "kind": "neutral",
      "text": "客人打听客栈开了多少年，问起掌柜的旧事。（原话：掌柜的，你这客栈开多少年了？可有旧相好？）",
      "state": "active",
      "source_refs": [],
      "artifact_refs": []
    },
    {
      "citation": {
        "memory_ref": {
          "family": "memory",
          "artifact_id": "memory",
