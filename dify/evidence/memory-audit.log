        "entry_version_id": "mem_ver_0f12e51e77dc470c890b4059bb779c9d"
      },
      "version": 1,
      "kind": "offense",
      "text": "客人摔碎了柜台上一只青瓷碗，还赖着不赔。（原话：我把你柜上的青瓷碗摔了，一文不赔）",
      "state": "active",
      "source_refs": [],
      "artifact_refs": []
    },
    {
      "citation": {
        "memory_ref": {
          "family": "memory",
          "artifact_id": "memory",
